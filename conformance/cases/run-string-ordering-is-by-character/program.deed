module conformance/case_ordering

// The one place text can be ordered at all: `<` takes `Int` and `String`
// and nothing else, so this is the language's own comparison rather than a
// library's.
fn shown(answer: Bool) -> String {
    if answer {
        "true"
    } else {
        "false"
    }
}

fn main(sys: System) -> ()
  uses
    Io.write,
{
    Io.write(sys.console, shown("10" < "9"))
    Io.write(sys.console, shown("b" < "a"))
}
