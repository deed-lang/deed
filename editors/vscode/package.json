{
  "name": "deed",
  "displayName": "Deed",
  "description": "Language support for Deed, including syntax highlighting and language server wiring.",
  "version": "0.1.0",
  "publisher": "deed-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/deed-lang/deed.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "deed",
        "aliases": [
          "Deed",
          "deed"
        ],
        "extensions": [
          ".deed"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "deed",
        "scopeName": "source.deed",
        "path": "./syntaxes/deed.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Deed",
      "properties": {
        "deed.server.path": {
          "type": "string",
          "default": "deed",
          "description": "Path to the Deed executable used to start the language server."
        },
        "deed.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed after `deed lsp` when starting the language server."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:deed"
  ],
  "scripts": {
    "test": "node --test ./test/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
