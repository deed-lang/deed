{
  "name": "deed",
  "displayName": "Deed",
  "description": "Language support for Deed, including syntax highlighting, language server wiring and a debugger.",
  "version": "0.1.0",
  "publisher": "deed-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/deed-lang/deed.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "contributes": {
    "languages": [
      {
        "id": "deed",
        "aliases": [
          "Deed",
          "deed"
        ],
        "extensions": [
          ".deed"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "deed",
        "scopeName": "source.deed",
        "path": "./syntaxes/deed.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "deed"
      }
    ],
    "debuggers": [
      {
        "type": "deed",
        "label": "Deed",
        "languages": [
          "deed"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .deed file whose `main` to run.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the first statement of `main`.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "deed",
            "request": "launch",
            "name": "Run this file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Deed: run this file",
            "description": "Run the open .deed file through its `main`.",
            "body": {
              "type": "deed",
              "request": "launch",
              "name": "Run this file",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Deed",
      "properties": {
        "deed.server.path": {
          "type": "string",
          "default": "deed",
          "description": "Path to the Deed executable. The same binary serves the language server and the debug adapter, so there is one setting rather than two that can disagree."
        },
        "deed.server.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed after `deed lsp` when starting the language server."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:deed",
    "onDebugResolve:deed"
  ],
  "scripts": {
    "test": "node --test ./test/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
