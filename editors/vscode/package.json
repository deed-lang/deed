{
  "name": "deed",
  "displayName": "Deed",
  "description": "Syntax highlighting for the Deed programming language.",
  "version": "0.1.0",
  "publisher": "deed-lang",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/deed-lang/deed.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "deed",
        "aliases": [
          "Deed",
          "deed"
        ],
        "extensions": [
          ".deed"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "deed",
        "scopeName": "source.deed",
        "path": "./syntaxes/deed.tmLanguage.json"
      }
    ]
  }
}
