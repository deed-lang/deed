// An import that is actually checked, in both halves.
//
// Everything in the `use` line is verified against what `examples/names.vow`
// declares, and so is everything done with it afterwards. Asking for a name
// that file does not have is VOW3008. Asking for a field a record does not
// have, calling a function with the wrong number of arguments, or forgetting a
// variant in a `match` are all errors here for the same reasons they would be
// if the declarations were written in this file.
//
// None of that was true two commits ago. An imported name had no type, and a
// name with no type agrees with everything, so a module boundary was a place
// where checking stopped.

module examples/greeting

use examples/names.{Greeting, Loud, Plain, Tone, louder}

// Exhaustive over a choice declared somewhere else. Adding a third `Tone` to
// `names.vow` breaks this function, which is the point of exhaustiveness and
// the reason a catch-all arm is refused here the same as anywhere.
fn describe(tone: Tone) -> String {
    match tone {
        Plain => "speaking",
        Loud => "shouting",
    }
}

// `greeting.tone` is a `Tone` because that is what `names.vow` says it is.
// Writing `greeting.tune` is VOW4004 and the message says which record it is
// and which module the record came from.
fn render(greeting: Greeting) -> String {
    describe(greeting.tone)
}

// These run. The interpreter holds the code of every module it was handed, so
// `describe` walks into the arms built from `names.vow`, and `Loud` here is the
// same value as the `Loud` built there. That last part is not free: a variant
// carries the module that declared it, because a `DefId` is an index into one
// module's table and the same variant reached two ways would otherwise compare
// unequal to itself.
test "a plain tone is not a loud one" {
    assert describe(Plain) != describe(Loud)
}

test "a record from another module is read here" {
    let greeting = Greeting { who: "world", tone: Loud }

    assert render(greeting) == "shouting"
    assert greeting.who == "world"
}

test "a call goes into the other module and comes back" {
    assert louder(Plain) == Loud
    assert describe(louder(Plain)) == "shouting"
}
