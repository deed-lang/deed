// Writing a file, which until now the language could not do at all.
//
// `examples/todo.vow` reads a list of tasks and reports on them, and the thing
// it could not do was add one. `Io` could read a file and open a directory and
// there was no operation that wrote one, so half of the smallest useful
// program was missing and `Dir` was a read capability wearing a more general
// name.
//
// This one appends a line to a journal and saves it. It writes into whichever
// directory it was handed, so point it somewhere you do not mind:
//
//   vow run examples/journal.vow --dir /tmp/journal
//
// The part worth reading is what stops it writing anywhere else. Two separate
// things do, and they are separate on purpose.
//
// The row. `note` declares `uses Io.save`, and a function that does not
// declare it cannot write, whatever it happens to be holding. `render` and
// `entries_in` declare nothing at all, so they cannot touch anything, and that
// is checked rather than hoped for.
//
// The capability. `Io.save` takes the `Dir` it writes into as an argument, and
// there is no way to construct one. Naming `..` is refused, so is an absolute
// path, and so is a symlink pointing out of the directory. Those are the same
// rules reading obeys, because it is the same check and not a second one that
// happens to agree today.
//
// There are three authorities over one `Dir` here, and they are three row
// entries rather than three types. `Io.read` lets a function read the file
// somebody told it about. `Io.save` lets it write one. `Io.list` lets it find
// out what is there, which is strictly more than reading and is the one most
// easily given away by accident: a directory handed over for one purpose
// usually has other things in it.

module examples/journal

// A file with nothing in it has no entries, rather than one empty entry.
// Splitting is honest about the edges, which is what makes it the inverse of
// joining, and this is where somebody has to decide what an empty file means.
fn entries_in(text: String) -> List<String> {
    if length(text) == 0 {
        []
    } else {
        split(text, "\n")
    }
}

fn render(entries: List<String>, line: String) -> String {
    join(push(entries, line), "\n")
}

// The only function here that can write. Everything above it is pure and stays
// that way, which is the ordinary shape: deciding what to write is not the
// same job as writing it.
fn note(files: Dir, name: String, line: String) -> Result<(), String>
  uses
    Io.read,
    Io.save,
{
    let existing = match Io.read(files, name) {
        ok(text) => text,
        err(why) => "",
    }

    Io.save(files, name, render(entries_in(existing), line))
}

// Enumerating, which is the third thing a `Dir` can be used for and the one
// that is not reading. Nothing was told which files are here; this is how a
// program finds out. Take `Io.list` out of the row and this does not compile,
// even though the `Dir` it is holding has not changed at all.
fn what_is_here(files: Dir) -> String
  uses
    Io.list,
{
    match Io.list(files) {
        ok(names) => join(names, ", "),
        err(why) => why,
    }
}

// Handed a real `Dir` and a name it must not be able to use. Every one of
// these comes back as an error naming the rule it hit, and the first three
// never reach the filesystem at all.
fn refusal(files: Dir, name: String) -> String
  uses
    Io.save,
{
    match Io.save(files, name, "this should never be written") {
        ok(nothing) => "allowed, which is a bug: " + name,
        err(why) => why,
    }
}

fn main(sys: System) -> Int
  uses
    Io.write,
    Io.read,
    Io.save,
    Io.list,
{
    let out = sys.console

    match note(sys.files, "journal.txt", "wrote a file for the first time") {
        ok(nothing) => Io.write(out, "saved"),
        err(why) => Io.write(out, why),
    }

    Io.write(out, refusal(sys.files, ".."))
    Io.write(out, refusal(sys.files, "../escape.txt"))
    Io.write(out, refusal(sys.files, "/etc/passwd"))
    Io.write(out, "here: " + what_is_here(sys.files))

    0
}

// What is still missing: deleting a file and creating a directory. Both are
// destructive in a way reading and listing are not, so they want their own
// argument about what a `Dir` means rather than being carried along with
// something else.
//
// Also `read_only()`, and it is the interesting one. Nothing here needs it,
// because a function that cannot write is a function that did not declare
// `Io.save`, and that is a row rather than a type. It starts to matter the
// moment a row can be a wildcard, which `sys.*` already is.

test "a line is added to whatever was there" {
    assert render([], "first") == "first"
    assert render(["one"], "two") == "one\ntwo"
    assert render(["one", "two"], "three") == "one\ntwo\nthree"
}

test "an empty file has no entries rather than one empty one" {
    assert entries_in("") == []
    assert entries_in("one") == ["one"]
    assert entries_in("one\ntwo") == ["one", "two"]
}

test "reading back what was rendered gives the same entries" {
    assert entries_in(render(["one"], "two")) == ["one", "two"]
}
