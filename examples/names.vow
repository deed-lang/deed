// The other side of an import. `vow check examples/` sees this file and
// `greeting.vow` at the same time, which is what makes the `use` in that file
// mean something.
//
// There is no visibility modifier in Vow, so every item here is exported. That
// is a decision rather than an omission: there are no wildcard imports, so the
// reader of the importing file already sees every name it pulled in, and `pub`
// on top of that buys a second, weaker version of the same guarantee.

module examples/names

choice Tone {
    Plain,
    Loud,
}

record Greeting {
    who: String,
    tone: Tone,
}

// Called from `greeting.vow`. The body runs with this module's names in scope,
// not the caller's, which matters because a call across a boundary that read
// the caller's scope would be a bug that does not announce itself.
fn louder(tone: Tone) -> Tone {
    match tone {
        Plain => Loud,
        Loud => Loud,
    }
}

// A `test` is not part of what a module offers. Nothing outside this file can
// name it, which is why `use examples/names.{the_tone_survives}` is an error.
test "the tone survives" {
    let g = Greeting { who: "world", tone: Loud }

    assert g.tone == Loud
}
