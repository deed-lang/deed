// The Proven tier, which is the part of this language that is supposed to be
// interesting.
//
// A refinement is only worth having if it replaces a check rather than
// decorating one. `vow check examples/proven.vow --obligations` says which of
// these the compiler settled at check time and which became a runtime guard,
// and it never claims to have proven something it did not.
//
// What does the proving is interval reasoning, plus a range for the difference
// between two names: what is known about each integer in scope, from the
// contract, from the types, from the conditions above the line, and from the
// contracts of the functions being called, arguments and all. It is not a
// solver, and three of the functions below are what that costs.

module examples/proven

type Positive = Int where value > 0

type Percent = Int where value >= 0 && value <= 100

type NonNegative = Int where value >= 0

record Order {
    quantity: Positive,
}

// Proven from the precondition. The `where` clause says exactly what the
// refinement needs, and nothing else has to be written down twice.
fn order_of(n: Int) -> Order
  where
    n > 0,
{
    Order { quantity: n }
}

// Proven from the guard. After an `if` that leaves, the rest of the body knows
// the condition failed, which is the ordinary way anyone establishes a
// refinement in real code.
fn checked_order(n: Int) -> Result<Order, String> {
    if n <= 0 {
        return err("a quantity has to be positive")
    }

    ok(Order { quantity: n })
}

// Proven in the else branch. The same fact arrived at from the other side: an
// `if` narrows what is known both ways, not just inside the then.
fn order_from_either(n: Int) -> Result<Order, String> {
    if n <= 0 {
        err("a quantity has to be positive")
    } else {
        ok(Order { quantity: n })
    }
}

// Proven from the type. A `Positive` is already known to be positive, so it
// fits where a weaker refinement is wanted without a `where` clause repeating
// the type in prose. Passing one where a `Positive` is wanted raises no
// obligation at all, which is why this asks for something else.
fn as_count(n: Positive) -> NonNegative {
    n
}

// Proven from arithmetic. Both bounds are known, so the sum is too.
fn clamped(raw: Int) -> Percent
  where
    raw >= 0,
    raw <= 50,
{
    raw + 50
}

// Guarded, and correctly so. `n` could be the largest integer there is, and
// then `n + 1` has no answer at all. Refusing to prove this is not a gap in
// the reasoning, it is the reasoning working.
fn one_more(n: Positive) -> Positive {
    n + 1
}

// Proven from a relationship. An interval has nowhere to put `low < high`, so
// there is a range for the difference of two names alongside the range for each
// one. The other two clauses are not there for the relationship, they are there
// so the subtraction has an answer at all.
fn span(low: Int, high: Int) -> Positive
  where
    low >= 0,
    high <= 100,
    low < high,
{
    high - low
}

// Guarded, and this one is the same limit as `one_more`. Nothing bounds either
// name, so `high - low` can be larger than an integer, and an expression with
// no answer proves nothing about the answer.
fn unbounded_span(low: Int, high: Int) -> Positive
  where
    low < high,
{
    high - low
}

// Proven across a call. `always_one` promises what it returns, the promise is
// read here, and the proof one function did is worth something to the next.
// Without this every abstraction boundary would restart the reasoning from
// nothing, which would make `ensures` decorative outside of tests.
fn from_a_call() -> Positive {
    always_one()
}

fn always_one() -> Int
  ensures
    ok  => result == 1,
{
    1
}

// Proven across a call that talks about its argument. `same` promises the
// result is the number it was handed, and what crosses the call is that
// difference: `result - n` is zero, `n` is positive, so the result is too.
// Before this, an `ensures` mentioning an argument was decorative outside of
// tests, and most of them mention an argument.
fn echoed(n: Positive) -> Positive {
    same(n)
}

fn same(n: Int) -> Int
  ensures
    ok  => result == n,
{
    n
}

// Proven through a `?`. A function that can fail promises things about the
// number inside the `ok`, and the caller is holding the `Result`, so the two
// only meet where the payload comes out. That is here, and at an `ok(..)`
// pattern, and nowhere else.
fn unwrapped() -> Result<Positive, String> {
    let n = maybe_one()?
    ok(n)
}

fn maybe_one() -> Result<Int, String>
  ensures
    ok  => result == 1,
{
    ok(1)
}

// Proven from a promise that counts its argument twice. A name multiplied by a
// number is still a name, so `result == n + n` is a difference like any other
// once the counting is done. A name multiplied by a name is not, which is the
// case below.
fn twice_over(n: Percent) -> Positive
  where
    n > 0,
{
    doubled(n)
}

fn doubled(n: Percent) -> Int
  ensures
    ok  => result == n + n,
{
    n + n
}

// Guarded. A promise that ties the result to an argument through a product of
// two names is not linear, and there is nowhere to put it short of a solver. A
// `Percent` squared is between nothing and ten thousand, and the tier says it
// did not work that out rather than pretending it did.
fn squared(n: Percent) -> Positive {
    square(n)
}

fn square(n: Percent) -> Int
  ensures
    ok  => result == n * n,
{
    n * n
}

test "the proven ones still hold at runtime" {
    assert order_of(3).quantity == 3
    assert as_count(4) == 4
    assert clamped(10) == 60
    assert span(2, 5) == 3
    assert from_a_call() == 1
    assert echoed(7) == 7
    assert twice_over(3) == 6
    assert unwrapped() == ok(1)
    assert order_from_either(0) == err("a quantity has to be positive")
}

// A test that only feeds a guard values it accepts proves nothing. This one
// used to do exactly that, and it passed through a period where the Guarded
// tier did not check return values at all: the compiler printed "so it becomes
// a runtime check" over a check that did not exist, and this test agreed with
// it.
//
// It still only feeds valid values, because a Vow test has no way to say "this
// must fail" and a file of examples has to pass. The tests that hand a guard
// something it should refuse are in crates/vow-driver/tests/guards.rs, one for
// every place a refined value can come into existence. Not being able to write
// them here is a gap in the test syntax, and worth naming.
test "the guarded ones are checked when they run" {
    assert one_more(1) == 2
    assert unbounded_span(2, 5) == 3
    assert squared(7) == 49
}
