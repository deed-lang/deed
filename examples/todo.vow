// A real program, written to find out what is missing rather than to show off
// what is there. `vow run examples/todo.vow --dir examples`
//
// It reads a list of tasks out of a file it was handed access to, adds one if
// it was given anything on the command line, counts them, and prints the ones
// that are not done:
//
//   vow run examples/todo.vow --dir examples -- buy milk
//
// That is the smallest thing anybody would call a program, and until recently
// none of it could be written down: there was no way to hold four tasks, no way
// to turn a count into something you could print, and no way to write a file.
//
// What it found, in the order it found it:
//
// 1. Three of its functions were the same function. Each was "start at 0, look
//    at each element, stop when `at` fails", and each declared `Diverge` for
//    it, because a function that can reach itself may not return. That was the
//    argument for iteration made by a program rather than by a design
//    document, and it is what #90 decided. The three walks below are `for`
//    loops now and none of them declares anything.
//
// 2. An accumulator had to be threaded through as a parameter, because handler
//    state is the only mutable thing in the language and reaching for a
//    handler to collect four strings would be using an effect to get around
//    not having a loop. The `for` here carries one and still nothing is
//    mutable: `found` is bound again on every turn rather than assigned.
//
// 3. The file format was `x|title` because that was what the language could
//    take apart. `[x] title` needed searching or slicing and there was
//    neither, so the data was bent to fit the tool. That is fixed in #108 by
//    the one text operation that could not be written in the language, and
//    the format below is the one a person would have written first. A title
//    containing the separator still loses its tail, which was true of `|` too
//    and is a separator being a separator rather than a hole in the language.
//
// 4. Splitting on `"\n"` left a `\r` on every line of a file written on
//    Windows, and there was no way to trim one off. The first run of this
//    program printed its own output backwards over itself for exactly that
//    reason, and the repository forcing LF was a program depending on
//    repository configuration to be correct. `trim` is the reason that is no
//    longer true, and it is the better half of what #108 was for.
//
// 5. Nine of its functions were three walks and six helpers, and every one of
//    the walks was the same walk with a different body. There was no way to
//    say so. Writing `map` once rather than once per element type needed a
//    generic function (#113); writing it once rather than once per effect
//    needed a row variable (#117). Those two are what
//    `examples/list.vow` is made of, and the section below is four functions
//    now, three of them one line.
//
// 6. Pointing this file at that library found the last one. The compiler only
//    looks at the files it was handed, so `vow run examples/todo.vow` could
//    not find `examples/list` and the workaround was to name every file the
//    program needs. A library nobody can use without knowing its file layout
//    is not a library. A module's name says where it lives now (#118), which
//    is a rule every file here already followed and nothing said out loud.
//
// What it still cannot do is mark a task done, which wants a way to say which
// one, which wants either an index or a search. Both are writable now; neither
// is written, because the point of this file is what it found rather than how
// complete it is.
module examples/todo

use examples/list.{map, filter, count_where}

record Task {
    done: Bool,
    title: String,
}

// One line to a task. `?` propagates the failure of either `at`, so a line
// with no separator in it comes back as an error rather than as a task with
// half of it missing.
//
// `trim` on both halves is what lets the format be `[x] ship it` rather than
// something chosen for the parser's convenience: the mark arrives as `[x` or
// `[` with a space still on it, and the title arrives with the space that
// followed the bracket.
fn parse(line: String) -> Result<Task, String> {
    let parts = split(line, "]")
    let mark = trim(at(parts, 0)?)
    let title = trim(at(parts, 1)?)

    ok(Task { done: mark == "[x", title })
}

// The three walks, which used to be three recursive functions and three
// `Diverge` declarations. They became three `for` loops, and they are three
// calls into `examples/list.vow` now, which is a library written in Vow rather
// than built into the compiler.
//
// That is the fifth thing this file found, and it took the longest to fix.
// Every walk here was the same walk with a different body and there was no way
// to say so. Writing `map` once instead of once per element type needed a
// generic function. Writing it once instead of once per effect needed a row
// variable. The nine functions this section used to hold are four now, and
// three of them are one line.
//
// A blank line is not a task and not an error worth reporting. A file that
// ends in a newline has one, which is the sort of thing you only find out by
// running the program.
fn tasks(lines: List<String>) -> List<Task> {
    for line in lines with found = [] {
        match parse(line) {
            ok(task) => push(found, task),
            err(why) => found,
        }
    }
}

fn walk(lines: List<String>) -> Int {
    length(tasks(lines))
}

fn count_done(lines: List<String>) -> Int {
    count_where(tasks(lines), |task: Task| task.done)
}

fn open_titles(lines: List<String>) -> List<String> {
    map(filter(tasks(lines), |task: Task| !task.done), |task: Task| task.title)
}

fn report(lines: List<String>) -> String {
    to_string(count_done(lines)) + " of " + to_string(walk(lines)) + " done"
}

// A file that is not there is not a crash. The capability says which directory
// this may read from and nothing says what is in it.
fn read_or(files: Dir, name: String, fallback: String) -> String
  uses
    Io.read,
{
    match Io.read(files, name) {
        ok(text) => text,
        err(why) => fallback,
    }
}

// Everything given on the command line becomes one task, so `vow run ... --
// buy milk` adds "buy milk" rather than two tasks nobody asked for. The
// trailing newline goes back on, because a text file without one is its own
// small wart and this is the only place that decides.
fn added(text: String, titles: List<String>) -> String {
    if length(titles) == 0 {
        text
    } else {
        join(push(entries_in(text), "[ ] " + join(titles, " ")), "\n") + "\n"
    }
}

// A `for` used as a filter, which is what there is: the accumulator either
// grows or does not. A file that ends in a newline has a blank entry at the
// end of it, and writing that back out would put a blank line in the middle of
// the file the next time something was added.
//
// `trim` is here for a duller reason and a more important one. A file written
// on Windows has a `\r` on the end of every line, and splitting on `"\n"`
// leaves it there. Before there was a way to take it off, this program printed
// its own output backwards over itself, and the only thing stopping that was
// the repository forcing LF. A program should not depend on how the repository
// holding it is configured.
fn entries_in(text: String) -> List<String> {
    for line in split(text, "\n") with kept = [] {
        if length(trim(line)) == 0 {
            kept
        } else {
            push(kept, trim(line))
        }
    }
}

fn main(sys: System) -> Int
  uses
    Io.write,
    Io.read,
    Io.save,
    Io.args,
{
    let out = sys.console
    let before = read_or(sys.files, "todo.txt", "")
    let after = added(before, Io.args(sys))

    // Saving only when something changed. A program that rewrote the file on
    // every run would touch it even when asked to do nothing, and a to-do list
    // whose timestamp moves for no reason is a to-do list nobody trusts.
    if before != after {
        match Io.save(sys.files, "todo.txt", after) {
            ok(nothing) => Io.write(out, "added"),
            err(why) => Io.write(out, why),
        }
    }

    let lines = entries_in(after)

    Io.write(out, report(lines))
    Io.write(out, "still open: " + join(open_titles(lines), ", "))

    0
}

test "a line becomes a task" {
    assert parse("[x] ship it") == ok(Task { done: true, title: "ship it" })
    assert parse("[ ] ship it") == ok(Task { done: false, title: "ship it" })
}

test "a line with nothing to split is not a task" {
    assert parse("") == err("index 1 is outside a list of 1")
    assert parse("no separator") == err("index 1 is outside a list of 1")
}

test "a line written on Windows is the same line" {
    assert entries_in("[x] one\r\n[ ] two\r\n") == ["[x] one", "[ ] two"]
    assert parse("[x] ship it\r") == ok(Task { done: true, title: "ship it" })
}

test "counting and collecting agree with each other" {
    let lines = ["[x] one", "[ ] two", "[ ] three", ""]

    assert walk(lines) == 3
    assert count_done(lines) == 1
    assert open_titles(lines) == ["two", "three"]
    assert report(lines) == "1 of 3 done"
}

test "an empty list is not a special case anywhere" {
    assert walk([]) == 0
    assert count_done([]) == 0
    assert open_titles([]) == []
    assert report([]) == "0 of 0 done"
}
