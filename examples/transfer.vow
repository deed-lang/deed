// The running example. Every design document refers back to this file.
//
// Nothing here compiles yet. There is no compiler. This is what we are aiming
// at, kept in one place so that changes to the design have to change something
// concrete instead of only changing prose.

module payments/transfer

use std/result.{Result, ok, err}
use ledger.{Ledger, Entry}
use audit.{Audit, Event}

// A refinement, so nothing downstream has to re-validate.
type Positive = Int where value > 0

record Money {
    units: Positive,
    currency: Currency,
}

record Receipt {
    from: AccountId,
    to: AccountId,
    amount: Money,
}

choice TransferError {
    InsufficientFunds { available: Money },
    AccountClosed { account: AccountId },
    CurrencyMismatch { expected: Currency, found: Currency },
}

// The contract is the review surface. A person reads everything above the
// opening brace and nothing below it.
fn transfer(from: AccountId, to: AccountId, amount: Money)
    -> Result<Receipt, TransferError>
  where
    from != to,
  uses
    Ledger.read,
    Ledger.write,
    Audit.append,
  ensures
    ok  => balance(from) == old(balance(from)) - amount,
    ok  => balance(to)   == old(balance(to))   + amount,
    ok  => total(Ledger) == old(total(Ledger)),
    err => unchanged(Ledger),
{
    let available = Ledger.balance(from)

    if available.currency != amount.currency {
        return err(CurrencyMismatch {
            expected: available.currency,
            found: amount.currency,
        })
    }

    if available < amount {
        return err(InsufficientFunds { available })
    }

    Ledger.post(Entry.debit(from, amount))
    Ledger.post(Entry.credit(to, amount))
    Audit.append(Event.TransferRecorded { from, to, amount })

    ok(Receipt { from, to, amount })
}

// Note what is absent, since that is the point.
//
//   - `amount.units > 0` is not a precondition, because `Positive` already
//     rules it out. There is no runtime check and no test for it.
//   - The function cannot open a socket or read a file. It did not ask for
//     those effects, so it does not have them.
//   - `err => unchanged(Ledger)` states the rollback guarantee without saying
//     anything about how it is implemented.
//   - `ok => total(Ledger) == old(total(Ledger))` is conservation. Money is
//     not created. Stating it once here replaces a category of test.

test "moves the money and conserves the total" {
    with InMemoryLedger { alice: 100.try, bob: 0.try },
         NullAudit
    {
        let receipt = transfer(alice, bob, 40.try).unwrap()

        assert receipt.amount == 40.try
        assert Ledger.balance(alice) == 60.try
        assert Ledger.balance(bob) == 40.try
    }
}

test "refuses to overdraw and leaves the ledger alone" {
    with InMemoryLedger { alice: 10.try, bob: 0.try },
         NullAudit
    {
        let result = transfer(alice, bob, 40.try)

        assert result == err(InsufficientFunds { available: 10.try })
        assert Ledger.balance(alice) == 10.try
        assert Ledger.balance(bob) == 0.try
    }
}
