// The running example. Every design document refers back to this file.
//
// Nothing here executes yet. It lexes, parses, resolves, type checks, and has
// its effect row checked against what its body actually performs. Names reached
// through an import are deliberately left unchecked, because nothing can
// honestly be said about the inside of a module that has not been loaded.
//
// The effects are declared here rather than imported, which is a change from
// the earlier version of this file. Importing them meant the compiler could not
// see their operations, and the effect row could not be checked at all. An
// example that imports away the one thing the language is about is not much of
// an example.

module payments/transfer

use accounts.{AccountId, Currency}
use ledger.{InMemoryLedger}
use audit.{NullAudit}

// A refinement, so nothing downstream has to re-validate.
type Positive = Int where value > 0

record Money {
    units: Positive,
    currency: Currency,
}

record Receipt {
    from: AccountId,
    to: AccountId,
    amount: Money,
}

record Entry {
    account: AccountId,
    amount: Money,
}

choice TransferError {
    InsufficientFunds { available: Money },
    AccountClosed { account: AccountId },
    CurrencyMismatch { expected: Currency, found: Currency },
}

choice AuditEvent {
    TransferRecorded { from: AccountId, to: AccountId, amount: Money },
}

// An effect declares operations and nothing else. A function that does not name
// one of these in its `uses` clause cannot perform it, and a function that names
// one it never performs is rejected too.
effect Ledger {
    fn balance(account: AccountId) -> Money
    fn total() -> Money
    fn post(entry: Entry) -> ()
}

effect Audit {
    fn append(event: AuditEvent) -> ()
}

// The contract is the review surface. A person reads everything above the
// opening brace and nothing below it.
fn transfer(from: AccountId, to: AccountId, amount: Money)
    -> Result<Receipt, TransferError>
  where
    from != to,
  uses
    Ledger.balance,
    Ledger.post,
    Audit.append,
  ensures
    ok  => Ledger.balance(from).units == old(Ledger.balance(from).units) - amount.units,
    ok  => Ledger.balance(to).units   == old(Ledger.balance(to).units)   + amount.units,
    ok  => Ledger.total() == old(Ledger.total()),
    err => unchanged(Ledger),
{
    let available = Ledger.balance(from)

    if available.currency != amount.currency {
        return err(CurrencyMismatch {
            expected: available.currency,
            found: amount.currency,
        })
    }

    if available.units < amount.units {
        return err(InsufficientFunds { available })
    }

    Ledger.post(Entry { account: from, amount })
    Ledger.post(Entry { account: to, amount })
    Audit.append(TransferRecorded { from, to, amount })

    ok(Receipt { from, to, amount })
}

fn money(units: Positive) -> Money {
    Money { units, currency: Currency.TRY }
}

// Note what is absent, since that is the point.
//
//   - `amount.units > 0` is not a precondition, because `Positive` already
//     rules it out. There is no runtime check and no test for it.
//   - The function cannot open a socket or read a file. It did not ask for
//     those effects, so it does not have them. It cannot call `Ledger.total`
//     either, even though `Ledger` is right there, because the row does not
//     name it.
//   - `err => unchanged(Ledger)` states the rollback guarantee without saying
//     anything about how it is implemented.
//   - `ok => Ledger.total() == old(Ledger.total())` is conservation. Money is
//     not created. Stating it once here replaces a category of test.
//   - The obligations talk about `.units` rather than about `Money` directly,
//     because there is no operator overloading and `Money - Money` means
//     nothing. That is the trade P4 asks for, visible.

test "moves the money and conserves the total" {
    let alice = AccountId.sample(1)
    let bob = AccountId.sample(2)

    with InMemoryLedger { opening: 100 },
         NullAudit
    {
        // `Result` has no methods, so there is no `unwrap`. Comparing the
        // whole thing says more anyway: it pins down the error case too.
        let expected = ok(Receipt { from: alice, to: bob, amount: money(40) })

        assert transfer(alice, bob, money(40)) == expected
        assert Ledger.balance(alice) == money(60)
    }
}

test "refuses to overdraw and leaves the ledger alone" {
    let alice = AccountId.sample(1)
    let bob = AccountId.sample(2)

    with InMemoryLedger { opening: 10 },
         NullAudit
    {
        let outcome = transfer(alice, bob, money(40))

        assert outcome == err(InsufficientFunds { available: money(10) })
        assert Ledger.balance(alice) == money(10)
    }
}

// An earlier version asserted `Ledger.balance(bob) == money(0)`, and the type
// checker rejected it: `Money.units` is `Positive`, so a zero balance cannot be
// written down at all. That is a real modelling mistake and it was sitting in
// this file the whole time. `Positive` is right for a transfer amount and wrong
// for a balance, and the two should probably not be the same type. Left as it
// is for now, with the assertion dropped, because the fix is a design question
// rather than a typo.
