// Using the list library, which is the point of it existing.
//
// `examples/list.vow` is written in Vow. Nothing in it is known to the
// compiler: no builtin, no special case, no name in the prelude. This file
// imports it and uses it three ways, and the third is the one that was
// impossible until row variables landed.
//
// 1. A callback that performs nothing. `map` performs nothing either, so
//    `doubled` declares nothing.
// 2. A named function passed as a value. Its declared row is what flows
//    through, the same as a closure's.
// 3. A callback that logs. `map` performs whatever it was handed, so
//    `announced` has to declare `Log.note` itself. It is the caller's row,
//    not the library's, and that is the whole argument for row variables:
//    the library says "whatever you gave me" and the caller says what that
//    was.
module examples/using_list

use examples/list.{map, filter, filtered_with, fold, any, all, count_where, first, reversed}

effect Log {
    fn note(message: String) -> ()
}

handler Counted implements Log {
    state seen: Int

    fn note(message) -> () {
        seen = seen + 1
    }
}

// 1. Nothing performed, nothing declared. The row variable came back empty
//    and the signature says so by saying nothing.
fn doubled(numbers: List<Int>) -> List<Int> {
    map(numbers, |n: Int| n + n)
}

fn positives(numbers: List<Int>) -> List<Int> {
    filter(numbers, |n: Int| n > 0)
}

fn total(numbers: List<Int>) -> Int {
    fold(numbers, 0, |sum: Int, n: Int| sum + n)
}

fn widths(words: List<String>) -> List<Int> {
    map(words, |word: String| length(word))
}

// 2. A declared function named where a value belongs. It carries its own
//    contract, and `map` inherits that rather than a closure's.
fn shout(word: String) -> String {
    word + "!"
}

fn shouted(words: List<String>) -> List<String> {
    map(words, shout)
}

// 3. The one that needed a row variable. `map` is the same `map` as above,
//    and this caller declares `Log.note` because that is what it handed over.
//    Take the effect out of the closure and this row becomes too wide, which
//    the compiler says out loud.
fn announced(numbers: List<Int>) -> List<Int>
  uses
    Log.note,
{
    map(
        numbers,
        |n: Int| {
        Log.note("saw a number")
        n + 1
    },
    )
}

fn counted_over(numbers: List<Int>) -> Int
  uses
    Log.note,
{
    count_where(
        numbers,
        |n: Int| {
        Log.note("checked one")
        n > 2
    },
    )
}

// 4. Two callbacks and one row variable. `keep` performs nothing, `dropped`
//    logs, and this declares `Log.note` because that is the sum of the two.
//    One variable in two parameters does not make the two callbacks agree: it
//    stands for whatever was passed at each place it appears. Under the other
//    reading this would not compile, since the two rows are different.
fn kept_loudly(numbers: List<Int>) -> List<Int>
  uses
    Log.note,
{
    let complain = |n: Int| Log.note("dropped one")
    filtered_with(numbers, |n: Int| n > 0, complain)
}

// The same call with nothing performed at either place. The variable came
// back empty from both, so this declares nothing.
fn kept_quietly(numbers: List<Int>) -> List<Int> {
    filtered_with(numbers, |n: Int| n > 0, |n: Int| ())
}

test "a callback that performs nothing" {
    assert doubled([1, 2, 3]) == [2, 4, 6]
    assert positives([0 - 1, 2, 0 - 3, 4]) == [2, 4]
    assert total([1, 2, 3, 4]) == 10
    assert widths(["a", "bbb"]) == [1, 3]
}

test "a named function is a value too" {
    assert shouted(["hi", "there"]) == ["hi!", "there!"]
}

test "the ones that need no callback" {
    assert first([1, 2]) == ok(1)
    assert first([]) == err("index 0 is outside a list of 0")
    assert reversed([1, 2, 3]) == [3, 2, 1]
}

test "any and all walk the same list two ways" {
    assert any([1, 2, 3], |n: Int| n > 2) == true
    assert any([1, 2], |n: Int| n > 5) == false
    assert all([1, 2], |n: Int| n > 0) == true
    assert all([1, 0], |n: Int| n > 0) == false
    assert all([], |n: Int| false) == true
}

test "two callbacks, and the caller is charged with both" {
    assert kept_quietly([0 - 1, 2, 0 - 3, 4]) == [2, 4]
    with Counted { seen: 0 } {
        assert kept_loudly([0 - 1, 2, 0 - 3]) == [2]
    }
}

test "a callback that performs an effect" {
    with Counted { seen: 0 } {
        assert announced([1, 2]) == [2, 3]
        assert counted_over([1, 2, 3]) == 1
    }
}
